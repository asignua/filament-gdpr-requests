{
    "name": "asignua/filament-gdpr-requests",
    "description": "Track GDPR data-subject requests in Filament 5: deadlines, a declared data map, exports, and previewed, four-eyes, idempotent erasure.",
    "keywords": [
        "filament",
        "filament-plugin",
        "laravel",
        "gdpr",
        "privacy",
        "data-subject-request",
        "erasure"
    ],
    "homepage": "https://github.com/asignua/filament-gdpr-requests",
    "support": {
        "issues": "https://github.com/asignua/filament-gdpr-requests/issues",
        "source": "https://github.com/asignua/filament-gdpr-requests"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Mykhailo Hladchenko",
            "email": "myhailo@hotmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-zip": "*",
        "filament/filament": "^5.11.2",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Asignua\\FilamentGdprRequests\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asignua\\FilamentGdprRequests\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asignua\\FilamentGdprRequests\\GdprRequestsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "asignua/filament-activity-log-plus": "Mirrors request actions (structure only) into the audit log under the name \"gdpr\"."
    }
}
